# ── Core (required) ─────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@localhost:5432/dungeon
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# ── Server (optional) ───────────────────────────────────────────
# NODE_ENV=production
# PORT=3000
# REQUIRED_APP_VERSION=1.0.40

# ── Website / smart links ───────────────────────────────────────
# Canonical https origin the site is served from (no trailing slash).
WEB_ORIGIN=https://dungeoncombat.org
# Store listing URLs — leave blank until listings are live (site shows "Coming soon").
APP_STORE_URL=
PLAY_STORE_URL=
# Where smart links send people without the app installed (e.g. TestFlight/APK page)
# until the store listings exist.
DOWNLOAD_FALLBACK_URL=
# Must match the mobile app.json "scheme".
APP_SCHEME=dungeoncombat

# ── Universal Links / App Links (optional — enable later) ────────
# iOS: "<TEAMID>.<bundleId>", e.g. ABCDE12345.com.dungeoncombat.app
IOS_APP_ID=
ANDROID_PACKAGE=com.dungeoncombat.app
# Android release signing cert SHA-256 (colon-separated hex from Play Console).
ANDROID_SHA256_FINGERPRINT=

# ── Support email (Resend) ──────────────────────────────────────
# Get a key at https://resend.com. Blank => the contact form is disabled and
# returns a friendly "email us directly" message.
RESEND_API_KEY=
# Verified sender on your Resend domain.
MAIL_FROM=Dungeon Combat <no-reply@dungeoncombat.org>
# Address shown on the site and used as reply-to.
SUPPORT_EMAIL=support@dungeoncombat.org
# Inbox that receives support-form submissions (defaults to SUPPORT_EMAIL).
SUPPORT_INBOX=support@dungeoncombat.org
